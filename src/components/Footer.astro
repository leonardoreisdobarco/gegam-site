---
import { site, navLinks } from "../data/site";
const ano = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="text-sm font-semibold text-brand">{site.nome}</p>
      <p class="mt-2 max-w-xs text-sm text-white/60">{site.nomeCompleto}</p>
      <p class="mt-1 text-xs text-white/40">{site.instituicao}</p>
    </div>

    <nav class="text-sm">
      <p class="font-semibold text-white/80">Navegação</p>
      <ul class="mt-2 space-y-1">
        {navLinks.map((l) => (
          <li><a href={l.href} class="text-white/60 hover:text-brand">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <p class="font-semibold text-white/80">Contato</p>
      <ul class="mt-2 space-y-1 text-white/60">
        <li><a href={`mailto:${site.email}`} class="hover:text-brand">{site.email}</a></li>
        <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-brand">Instagram @gegam.ifmuz</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/40">
    © {ano} {site.nome} · {site.instituicao}
  </div>
</footer>
