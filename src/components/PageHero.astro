---
interface Props {
  titulo: string;
  subtitulo?: string;
}
const { titulo, subtitulo } = Astro.props;
---
<section class="border-b border-white/10 bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{titulo}</h1>
    {subtitulo && <p class="mt-3 max-w-2xl text-white/60">{subtitulo}</p>}
  </div>
</section>
