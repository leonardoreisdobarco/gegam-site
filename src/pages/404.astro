---
import Layout from "../layouts/Layout.astro";
---

<Layout titulo="Página não encontrada">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-extrabold text-brand">404</p>
    <h1 class="mt-4 text-2xl font-bold">Página não encontrada</h1>
    <p class="mt-2 text-white/60">O endereço que você acessou não existe ou foi movido.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-ink hover:bg-brand-dark"
    >
      Voltar ao início
    </a>
  </div>
</Layout>
