---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<Layout titulo="Participe">
  <PageHero
    titulo="Participe do GEGAM"
    subtitulo="Aberto a estudantes do IFSULDEMINAS interessados em geotecnologia, agricultura e meio ambiente."
  />

  <div class="mx-auto max-w-3xl space-y-10 px-4 py-14">
    <section class="text-white/80">
      <h2 class="text-xl font-bold text-white">Quem pode participar</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">
        <li>Estudantes regularmente matriculados no {site.instituicao}.</li>
        <li>Interesse em sensoriamento remoto, drones, agricultura digital ou topografia.</li>
        <li>Disponibilidade para os encontros do grupo.</li>
      </ul>
      <p class="mt-3 text-sm text-white/50">
        <em>Requisitos provisórios — ajustar conforme o edital do processo seletivo.</em>
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-white">Inscrição</h2>
      {
        site.formularioInscricao ? (
          <div class="mt-4 overflow-hidden rounded-xl border border-white/10">
            <iframe
              src={site.formularioInscricao}
              class="h-[720px] w-full bg-white"
              title="Formulário de inscrição GEGAM"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="mt-4 rounded-xl border border-dashed border-brand/40 bg-brand/5 p-6 text-white/70">
            <p class="font-medium text-brand">Inscrições fora do período.</p>
            <p class="mt-2 text-sm">
              Quando o processo seletivo abrir, o formulário aparecerá aqui.
              Acompanhe as chamadas no{" "}
              <a href={site.instagram} target="_blank" rel="noopener" class="text-brand hover:underline">
                Instagram @gegam.ifmuz
              </a>
              .
            </p>
            <p class="mt-3 text-xs text-white/40">
              Bolsista: cole o link do Google Forms em <code>formularioInscricao</code>{" "}
              no arquivo <code>src/data/site.ts</code>.
            </p>
          </div>
        )
      }
    </section>

    <section class="text-white/80">
      <h2 class="text-xl font-bold text-white">Dúvidas</h2>
      <p class="mt-3">
        Fale com a gente por{" "}
        <a href={`mailto:${site.email}`} class="text-brand hover:underline">e-mail</a> ou
        pelo direct do Instagram.
      </p>
    </section>
  </div>
</Layout>
